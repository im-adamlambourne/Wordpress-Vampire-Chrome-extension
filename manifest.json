{
  "manifest_version": 3,
  "name": "Content Studio Plugin",
  "version": "0.6.0",
  "description": "Revise WordPress drafts from a chat overlay: title, body, excerpt, SEO, Open Graph, and focus keyphrase.",
  "permissions": ["tabs", "storage", "identity", "notifications", "offscreen"],
  "host_permissions": ["*://*/wp-admin/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Content Studio Plugin",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/wp-admin/*"],
      "js": ["content/detect.js", "content/chat-modal.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*/wp-admin/*"],
      "js": ["content/editor-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/robot.png", "assets/chat-notification.mp3", "icons/icon-48.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
