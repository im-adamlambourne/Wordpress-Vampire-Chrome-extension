{
  "manifest_version": 3,
  "name": "Content Studio",
  "version": "0.9.0",
  "description": "Revise WordPress drafts from a chat overlay. Sign in from the toolbar popup.",
  "permissions": ["tabs", "storage", "identity", "notifications", "offscreen"],
  "optional_host_permissions": [
    "https://content-studio.im/*",
    "https://develop.content-studio.im/*",
    "https://ws.content-studio.im/*",
    "https://ws.develop.content-studio.im/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8081/*",
    "http://127.0.0.1:8081/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Content Studio",
    "default_icon": {
      "16": "icons/icon-16-disconnected.png",
      "32": "icons/icon-32-disconnected.png",
      "48": "icons/icon-48-disconnected.png",
      "128": "icons/icon-128-disconnected.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.production.wcp.imdserve.com/wp-admin/*",
        "https://*.release.wcp.imdserve.com/wp-admin/*",
        "http://localhost/wp-admin/*",
        "http://127.0.0.1/wp-admin/*"
      ],
      "js": ["content/post-type-fields.js", "content/detect.js", "content/chat-modal.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.production.wcp.imdserve.com/wp-admin/*",
        "https://*.release.wcp.imdserve.com/wp-admin/*",
        "http://localhost/wp-admin/*",
        "http://127.0.0.1/wp-admin/*"
      ],
      "js": ["content/post-type-fields.js", "content/editor-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/robot.png", "assets/chat-notification.mp3", "icons/icon-48.png"],
      "matches": [
        "https://*.production.wcp.imdserve.com/*",
        "https://*.release.wcp.imdserve.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
